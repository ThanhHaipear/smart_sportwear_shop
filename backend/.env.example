# Application
SERVER_PORT=8082
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL local by default. Do not point automated tests at shared Supabase.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_sportswear
DB_USERNAME=postgres
DB_PASSWORD=replace-me
DB_PARAMS=

# Keep disabled until the reviewed V2 baseline exists.
SPRING_FLYWAY_ENABLED=false
APP_SEED_ENABLED=false

# Authentication: generate independent random values of at least 32 bytes.
JWT_ACCESS_SECRET=replace-with-random-access-secret-at-least-32-bytes
JWT_REFRESH_SECRET=replace-with-random-refresh-secret-at-least-32-bytes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
PASSWORD_RESET_URL=http://localhost:3000/dat-lai-mat-khau
APP_FRONTEND_URL=http://localhost:3000

# Optional Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8082/api/v1/auth/google/callback

# Product image storage. Use none until Cloudinary credentials are configured.
APP_STORAGE_PROVIDER=none
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_IMAGE_FOLDER=products

# Mail defaults to log-only local mode.
APP_MAIL_PROVIDER=logging
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false

# Redis and RabbitMQ local infrastructure
REDIS_HOST=localhost
REDIS_PORT=6379
NOTIFICATIONS_STREAM_REDIS=false
RABBITMQ_ADDRESSES=localhost:5672
RABBITMQ_USERNAME=visual_search
RABBITMQ_PASSWORD=replace-local-rabbitmq-password

# Legacy hybrid search adapter. Disabled until AI Retrieval V2 is ready.
PRODUCT_HYBRID_SEARCH_ENABLED=false
PRODUCT_SEARCH_SERVICE_URL=http://127.0.0.1:8002
PRODUCT_SEARCH_INTERNAL_TOKEN=replace-with-random-internal-token
PRODUCT_SEARCH_TIMEOUT_SECONDS=12
PRODUCT_SEARCH_RATE_LIMIT_PER_MINUTE=30

# Legacy visual-search adapter. Disabled until migration to AI Retrieval V2.
VISUAL_SEARCH_ENABLED=false
VISUAL_SEARCH_SERVICE_URL=http://127.0.0.1:8090
VISUAL_SEARCH_INTERNAL_TOKEN=replace-with-random-internal-token
VISUAL_SEARCH_REQUEST_TIMEOUT_SECONDS=15
VISUAL_SEARCH_RATE_LIMIT_PER_MINUTE=10
CATALOG_IMAGE_ALLOWED_HOSTS=res.cloudinary.com
VISUAL_SEARCH_OUTBOX_POLL_DELAY_MS=1000
VISUAL_SEARCH_OUTBOX_BATCH_SIZE=25
VISUAL_SEARCH_OUTBOX_CONFIRM_TIMEOUT_SECONDS=5
VISUAL_SEARCH_OUTBOX_MAX_ATTEMPTS=10

# Service-to-service secret. Must not reuse JWT or provider secrets.
AI_SYNC_SECRET=replace-with-random-ai-sync-secret

# Experimental/demo features remain off in the default runtime.
FORECAST_DEMO_ENABLED=false

# Commerce configuration
ORDER_PENDING_EXPIRY_MINUTES=30
LOW_STOCK_THRESHOLD=10

# VNPay sandbox. Leave credentials blank until sandbox integration is tested.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
PAYMENT_RETURN_URL=http://localhost:3000/payment/result
PAYMENT_CALLBACK_URL=http://localhost:8082/api/v1/payments/callback
VNPAY_TRANSACTION_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
