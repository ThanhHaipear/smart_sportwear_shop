# Supabase PostgreSQL
DB_HOST=your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_PARAMS=?sslmode=require

# Redis runs locally through Docker Compose
REDIS_HOST=localhost
REDIS_PORT=6379

# Visual-search transactional outbox publisher (RabbitMQ from docker-compose)
VISUAL_SEARCH_ENABLED=false
VISUAL_SEARCH_SERVICE_URL=http://127.0.0.1:8090
VISUAL_SEARCH_INTERNAL_TOKEN=
CATALOG_IMAGE_ALLOWED_HOSTS=res.cloudinary.com,cdn.shopify.com
VISUAL_SEARCH_REQUEST_TIMEOUT_SECONDS=5
VISUAL_SEARCH_RATE_LIMIT_PER_MINUTE=10
RABBITMQ_ADDRESSES=localhost:5672
RABBITMQ_USERNAME=visual_search
RABBITMQ_PASSWORD=change-me
VISUAL_SEARCH_OUTBOX_POLL_DELAY_MS=1000
VISUAL_SEARCH_OUTBOX_BATCH_SIZE=25
VISUAL_SEARCH_OUTBOX_CONFIRM_TIMEOUT_SECONDS=5
VISUAL_SEARCH_OUTBOX_MAX_ATTEMPTS=10

# Local integrations
APP_MAIL_PROVIDER=logging
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false

APP_STORAGE_PROVIDER=none
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_IMAGE_FOLDER=smart-sportswear/products

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8082/api/v1/auth/google/callback
APP_FRONTEND_URL=http://localhost:3000

# VNPay Sandbox (replace with credentials issued for your sandbox merchant)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
PAYMENT_RETURN_URL=http://localhost:3000/payment/result
PAYMENT_CALLBACK_URL=http://localhost:8082/api/v1/payments/callback
VNPAY_TRANSACTION_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
ORDER_PENDING_EXPIRY_MINUTES=30
SERVER_PORT=8082
PRODUCT_HYBRID_SEARCH_ENABLED=false
PRODUCT_SEARCH_SERVICE_URL=http://127.0.0.1:8002
PRODUCT_SEARCH_INTERNAL_TOKEN=change-me
PRODUCT_SEARCH_TIMEOUT_SECONDS=12
PRODUCT_SEARCH_RATE_LIMIT_PER_MINUTE=30
