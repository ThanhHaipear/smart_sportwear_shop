# Legacy Assistant + hybrid-search service. It will be split during V2 migration.
# Runtime environment
CHATBOT_ENV=development
CHATBOT_HOST=0.0.0.0
CHATBOT_PORT=8002
CHATBOT_RELOAD=false

# Model. Use provider=none for a no-cost local/smoke configuration when supported.
MODEL_PROVIDER=none
MODEL_NAME=deterministic-local

# DB read-only connection. Prefer local PostgreSQL during development.
DB_READ_URL=

# DB write connection for durable chat history. Leave empty to disable history persistence.
DB_WRITE_URL=

# Backend Spring Boot API (for transaction tools — Phase 5+)
BACKEND_API_BASE_URL=http://localhost:8082

# Must match backend JWT_ACCESS_SECRET. Used to verify access tokens locally.
JWT_ACCESS_SECRET=replace-with-the-exact-backend-access-secret

# Redis (for session/memory — Phase 9+)
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=3600

# Observability (Phase 9+)
OBSERVABILITY_ENABLED=true
EVALUATION_LOGGING_ENABLED=true

# Logging
LOG_LEVEL=INFO

# LLM API key for MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required for OpenAI product embeddings; also used when MODEL_PROVIDER=openai.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
PRODUCT_SEARCH_INTERNAL_TOKEN=replace-with-the-exact-backend-internal-token
PRODUCT_SEARCH_SEMANTIC_ENABLED=false
PRODUCT_SEARCH_LLM_REWRITE_ENABLED=false
PRODUCT_SEARCH_RRF_K=60
PRODUCT_SEARCH_KEYWORD_WEIGHT=1.2
PRODUCT_SEARCH_SEMANTIC_WEIGHT=1.0
PRODUCT_SEARCH_MIN_SIMILARITY=0.40
PRODUCT_SEARCH_QUERY_CACHE_TTL_SECONDS=604800
PRODUCT_SEARCH_INDEXING_ENABLED=false
RABBITMQ_URL=amqp://visual_search:change-me@localhost:5672/
PRODUCT_SEARCH_INDEXING_QUEUE=product-search.indexing
PRODUCT_SEARCH_INDEXING_RETRY_QUEUES=product-search.indexing.retry.30s,product-search.indexing.retry.5m,product-search.indexing.retry.1h
PRODUCT_SEARCH_INDEXING_DLQ=product-search.indexing.dlq
PRODUCT_SEARCH_INDEXING_PREFETCH=5
PRODUCT_SEARCH_RECONCILIATION_INTERVAL_SECONDS=3600
PRODUCT_SEARCH_RECONCILIATION_BATCH_SIZE=100
