# Runtime environment
CHATBOT_ENV=development
CHATBOT_HOST=0.0.0.0
CHATBOT_PORT=8002
CHATBOT_RELOAD=false

# Model
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-sonnet-4-6

# The only API-runtime database connection. Use chatbot_app and search_path=chatbot,public.
CHATBOT_DATABASE_URL=postgresql+asyncpg://chatbot_app:password@host:5432/dbname

# Service-to-service RAG dependencies (same token during the current cut-over).
SEARCH_API_BASE_URL=http://localhost:8090
SEARCH_SERVICE_TOKEN=change-me
SEARCH_API_TIMEOUT_SECONDS=5
CATALOG_API_BASE_URL=http://localhost:8092
CATALOG_SERVICE_TOKEN=change-me
CATALOG_API_TIMEOUT_SECONDS=5

# Backend Spring Boot API (for transaction tools — Phase 5+)
BACKEND_API_BASE_URL=http://localhost:8085

# Must match backend JWT_ACCESS_SECRET. Used to verify access tokens locally.
JWT_ACCESS_SECRET=change-me-to-the-same-secret-as-spring-boot

# Redis (for session/memory — Phase 9+)
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=3600

# Observability (Phase 9+)
OBSERVABILITY_ENABLED=true
EVALUATION_LOGGING_ENABLED=true

# Logging
LOG_LEVEL=INFO

# LLM API key for MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Required for OpenAI product embeddings; also used when MODEL_PROVIDER=openai.
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
PRODUCT_SEARCH_QUERY_CACHE_TTL_SECONDS=604800
