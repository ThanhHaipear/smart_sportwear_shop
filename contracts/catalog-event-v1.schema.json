{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-sportswear.local/contracts/catalog-event-v1.schema.json",
  "title": "Catalog event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "productId",
    "sourceVersion",
    "occurredAt",
    "traceId"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": {
      "type": "string",
      "enum": [
        "PRODUCT_IMAGE_CREATED",
        "PRODUCT_IMAGE_DELETED",
        "PRODUCT_ACTIVATED",
        "PRODUCT_DEACTIVATED",
        "PRODUCT_DELETED",
        "PRODUCT_REINDEX_REQUESTED"
      ]
    },
    "eventVersion": { "const": 1 },
    "productId": { "type": "string", "format": "uuid" },
    "sourceVersion": { "type": "integer", "minimum": 0 },
    "imageId": { "type": ["string", "null"], "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "traceId": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "enum": ["PRODUCT_IMAGE_CREATED", "PRODUCT_IMAGE_DELETED"]
          }
        }
      },
      "then": {
        "required": ["imageId"],
        "properties": {
          "imageId": { "type": "string", "format": "uuid" }
        }
      }
    }
  ]
}
