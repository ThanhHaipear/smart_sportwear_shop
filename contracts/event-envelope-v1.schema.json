{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-sportswear.local/contracts/event-envelope-v1.schema.json",
  "title": "Integration event envelope v1",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "traceId"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "eventVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "traceId": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
