{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-sportswear.local/contracts/sales-order-created-event-v1.schema.json",
  "title": "Sales order created event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "traceId", "orderId", "items"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"const": "ORDER_CREATED"},
    "eventVersion": {"const": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "traceId": {"type": "string", "minLength": 1, "maxLength": 128},
    "orderId": {"type": "string", "format": "uuid"},
    "userRef": {"type": ["string", "null"], "maxLength": 100},
    "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}}
  }
}
