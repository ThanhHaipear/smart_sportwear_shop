    SF & AD --> GW
    SEPAY --> GW
    GW --> IDS & CAS & SAS & CHS & RES

    IDS --> D1
    CAS --> D2
    SAS --> D3
    SES --> D4
    RES --> D5
    CHS --> D6
    CHS --> RD

    SAS -- "internal API: snapshot giá, giữ/xác nhận tồn" --> CAS
