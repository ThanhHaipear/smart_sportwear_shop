# Core ecommerce backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8082
SERVER_API_BASE_URL=http://localhost:8082

# Independent AI forecasting backend
NEXT_PUBLIC_AI_API_BASE_URL=http://localhost:8081
SERVER_AI_API_BASE_URL=http://localhost:8081

# Phase 6 Admin Copilot
NEXT_PUBLIC_ADMIN_COPILOT_API_BASE_URL=http://localhost:8003
SERVER_ADMIN_COPILOT_API_BASE_URL=http://localhost:8003

# Disabled by default: hides AI Insights, Admin Copilot and Chatbot Config and
# prevents those screens from issuing their dedicated API requests.
# Set to true when these three admin workspaces are needed again.
NEXT_PUBLIC_ADMIN_AI_WORKSPACES_ENABLED=false
