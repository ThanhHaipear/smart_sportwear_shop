RECOMMENDATION_ENABLED=false
RECOMMENDATION_DATABASE_URL=
RECOMMENDATION_INTERNAL_TOKEN=change-me
RECOMMENDATION_FALLBACK_MODE=POPULAR
# OFF | SIMILAR | COMPLEMENT: content layer between association rules and popularity
RECOMMENDATION_CONTENT_MODE=COMPLEMENT
RECOMMENDATION_DEFAULT_LIMIT=8
RECOMMENDATION_MAX_LIMIT=20
INTERACTION_RATE_LIMIT_PER_IDENTITY=60
INTERACTION_RATE_LIMIT_PER_IP=300
# Enable only for a dedicated demo environment.
INTERACTION_DEMO_ENABLED=false
# Keep false until the retention proposal (docs/recommendation-retention-proposal.md) is approved and running.
INTERACTION_REAL_ENABLED=false
CATALOG_API_URL=http://127.0.0.1:8092
CATALOG_SERVICE_TOKEN=
CATALOG_REQUEST_TIMEOUT_SECONDS=5
RABBITMQ_URL=amqp://visual_search:change-me@localhost:5672/
RABBITMQ_CONSUMER_QUEUE=recommendation.events
RABBITMQ_RETRY_QUEUES=recommendation.events.retry.30s,recommendation.events.retry.5m,recommendation.events.retry.1h
RABBITMQ_DLQ=recommendation.events.dlq
RABBITMQ_PREFETCH_COUNT=10
